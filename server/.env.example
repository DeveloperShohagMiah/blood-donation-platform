NODE_ENV=development
PORT=5000

MONGODB_URI=your-mongodb-connection-string

CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Required: at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Development only: returns the OTP in the response instead of only logging it.
OTP_DEV_RETURN=false
