{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "checkJs": false,
    "module": "esnext",
    "moduleResolution": "bundler",
